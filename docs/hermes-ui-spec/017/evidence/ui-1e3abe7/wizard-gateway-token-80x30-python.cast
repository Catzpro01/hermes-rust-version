[1.345765,"o","\u001b[39;49m\u001b[?25l\u001b[39;49m\u001b(B\u001b[m\u001b[H\u001b[2J\u001b(B\u001b[0;1m\u001b[33mSelect platforms to configure:\r\u001b[2d\u001b[39m\u001b(B\u001b[0;2m  ↑↓ navigate  SPACE toggle  ENTER confirm  ESC cancel\r\u001b[4d\u001b(B\u001b[0;1m\u001b[32m → [ ] 💬 Mattermost  (not configured)\u001b[5;4H\u001b[39m\u001b(B\u001b[m[ ] 📡 Signal  (not configured)\u001b[6;4H[ ] 💬 Weixin / WeChat  (not configured)\u001b[7;4H[ ] 💬 BlueBubbles (iMessage)  (not configured)\u001b[8;4H[ ] 🐧 QQ Bot  (not configured)\u001b[9;4H[ ] 💎 Yuanbao  (not configured)\u001b[10;4H[ ] 🧩 A2A  (not configured)\u001b[11;4H[ ] 🐝 Buzz  (not configured)\u001b[12;4H[ ] 🐳 DingTalk  (not configured)\u001b[13;4H[ ] 🎮 Discord  (not configured)\u001b[14;4H[ ] 📧 Email  (not configured)\u001b[15;4H[ ]   Feishu / Lark  (not configured)\u001b[16;4H[ ] 💬 Google Chat  (not configured)\u001b[17;4H[ ] 🏠 Home Assistant  (not configured)\u001b[18;4H[ ] 💬 IRC  (not configured)\u001b[19;4H[ ] 💚 LINE  (not configured)\u001b[20;4H[ ] 🔐 Matrix  (not configured)\u001b[21;4H[ ] 🔔 ntfy  (not configured)\u001b[22;4H[ ] 📱 iMessage via Photon  (not configured)\u001b[23;4H[ ] 🔔 Raft  (not configured)\u001b[24;4H[ ] 🔒 SimpleX Chat  (not configured)\u001b[25;4H[ ] 📱 SMS (Twilio)  (not configured)\u001b[26;4H[ ] 💼 Microsoft Teams  (not configured)\u001b[27;4H[ ] ✈️ Telegram  (not configured)\u001b[28;4H[ ] 💬 WhatsApp  (not configured)"]
[1.649116,"o","\u001b[H\u001b[2J\u001b(B\u001b[0;1m\u001b[33mSelect platforms to configure:\r\u001b[2d\u001b[39m\u001b(B\u001b[0;2m  ↑↓ navigate  SPACE toggle  ENTER confirm  ESC cancel\r\u001b[4d\u001b(B\u001b[0;1m\u001b[32m → [✓] 💬 Mattermost  (not configured)\u001b[5;4H\u001b[39m\u001b(B\u001b[m[ ] 📡 Signal  (not configured)\u001b[6;4H[ ] 💬 Weixin / WeChat  (not configured)\u001b[7;4H[ ] 💬 BlueBubbles (iMessage)  (not configured)\u001b[8;4H[ ] 🐧 QQ Bot  (not configured)\u001b[9;4H[ ] 💎 Yuanbao  (not configured)\u001b[10;4H[ ] 🧩 A2A  (not configured)\u001b[11;4H[ ] 🐝 Buzz  (not configured)\u001b[12;4H[ ] 🐳 DingTalk  (not configured)\u001b[13;4H[ ] 🎮 Discord  (not configured)\u001b[14;4H"]
[1.651709,"o","[ ] 📧 Email  (not configured)\u001b[15;4H[ ]   Feishu / Lark  (not configured)\u001b[16;4H[ ] 💬 Google Chat  (not configured)\u001b[17;4H[ ] 🏠 Home Assistant  (not configured)\u001b[18;4H[ ] 💬 IRC  (not configured)\u001b[19;4H[ ] 💚 LINE  (not configured)\u001b[20;4H[ ] 🔐 Matrix  (not configured)\u001b[21;4H[ ] 🔔 ntfy  (not configured)\u001b[22;4H[ ] 📱 iMessage via Photon  (not configured)\u001b[23;4H[ ] 🔔 Raft  (not configured)\u001b[24;4H[ ] 🔒 SimpleX Chat  (not configured)\u001b[25;4H[ ] 📱 SMS (Twilio)  (not configured)\u001b[26;4H[ ] 💼 Microsoft Teams  (not configured)\u001b[27;4H[ ] ✈️ Telegram  (not configured)\u001b[28;4H[ ] 💬 WhatsApp  (not configured)\u001b[?1l\u001b>\u001b[30;1H\u001b[?12l\u001b[?25h\u001b[?1049l\u001b[23;0;0t\r\u001b[?1l\u001b>\r\n\u001b[36m  ─── 💬 Mattermost Setup ───\u001b[0m\r\n\r\n\u001b[2m    1. In Mattermost: Integrations → Bot Accounts → Add Bot Account\u001b[0m\r\n\u001b[2m       (System Console → Integrations → Bot Accounts must be enabled)\u001b[0m\r\n\u001b[2m    2. Give it a username (e.g. hermes) and copy the bot token\u001b[0m\r\n\u001b[2m    3. Works with any self-hosted Mattermost instance — enter your server URL\u001b[0m\r\n\u001b[2m    4. To find your user ID: click your avatar (top-left) → Profile\u001b[0m\r\n\u001b[2m       Your user ID is displayed there — click it to copy.\u001b[0m\r\n\u001b[2m       ⚠ This is NOT your username — it's a 26-character alphanumeric ID.\u001b[0m\r\n\u001b[2m    5. To get a channel ID: click the channel name → View Info → copy the ID\u001b[0m\r\n\r\n\u001b[2m    Your Mattermost server URL. Works with any self-hosted instance.\u001b[0m\r\n"]
