+                "01a09c9f-9e70-7600-8bdd-fa8f1c2edb20",
+                48,
+            ),
+            (
+                95,
+                "/tmp/hermes-visual-3jg1uo86/demo",
+                "01a09c9f-9e82-7390-8e0a-c738202a5bca",
+                49,
+            ),
+        ] {
+            let mut info = banner_info(
+                Some("parity-fixture"),
